<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryShadeDarkColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Blocked Apps"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/tvInstruction"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Select apps to block. Default blocking time is 09:00 - 17:00." />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBlockedApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@android:layout/simple_list_item_multiple_choice" />

        <Button
            android:id="@+id/btnAddBlockedApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add/Edit Blocked Apps" />

    </LinearLayout>
</FrameLayout>
